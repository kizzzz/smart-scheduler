# 复制为 .env 后填写，切勿提交真实密钥
# cp .env.example .env

# ===== 智谱 GLM =====
# 必填。API Key 只存在服务端环境变量，永远不下发到前端
GLM_API_KEY=
GLM_MODEL=glm-4-flash
GLM_TIMEOUT=12
GLM_RETRIES=2
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 仅当服务器出网需要代理时设置，留空表示直连
# GLM_PROXY=http://127.0.0.1:8118

# ===== 站点地址 =====
# 只有公网 IP、没有域名：保持 :80（纯 HTTP）
# 有域名并已解析到本机：填域名，Caddy 会自动签发并续期 HTTPS 证书
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com
# 服务器公网 IP。填了之后即使域名还没解析过来，也能用 http://<IP>/ 直接访问自检
SERVER_IP=

# ===== 其他 =====
# 前后端同域部署时无需放开跨域，保持 * 也不会有额外风险（无 Cookie 凭证）
CORS_ORIGINS=*
