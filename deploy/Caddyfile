# 边缘 Caddy 配置：静态前端 + /api 反代 FastAPI
#
# 两个站点地址同时生效，互不冲突：
#   1. {$SITE_ADDRESS::80}          域名站点。设成域名时 Caddy 自动申请 / 续期
#      Let's Encrypt 证书并 301 到 HTTPS；DNS 还没解析过来时 ACME 会后台重试，
#      不影响下面的 IP 直连。未设置时退化为 :80 catch-all（纯 HTTP）。
#   2. http://{$SERVER_IP:127.0.0.1} IP 直连站点，纯 HTTP。用于域名还没生效、
#      或运维想绕开域名自检的场景。未设置时指向 127.0.0.1，对外无影响。
#
# 站点逻辑只写一份，用 snippet 复用。
{
	email {$ACME_EMAIL:admin@example.com}
	admin off
}

(app) {
	encode gzip zstd

	# 后端 API：同域 /api 前缀，前端全部使用相对路径，无需 CORS
	handle /api/* {
		reverse_proxy api:8000 {
			# 主动健康检查间隔要短：容器冷启动时 api 会晚几秒才 listen，
			# 若间隔 30s，第一次探测失败后会有长达 30s 的 503 空窗（已实测踩到）。
			health_uri /api/health
			health_interval 5s
			health_timeout 3s

			# 单个请求内重试，进一步吃掉冷启动窗口
			lb_try_duration 5s
			lb_try_interval 250ms

			transport http {
				read_timeout 60s
			}
		}
	}

	# 静态前端
	handle {
		root * /srv

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

{$SITE_ADDRESS::80} {
	import app
}

http://{$SERVER_IP:127.0.0.1} {
	import app
}
